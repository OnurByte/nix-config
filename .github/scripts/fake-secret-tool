#!/usr/bin/env bash
set -euo pipefail

root="${VESPER_FAKE_SECRET_DIR:?}"
command="$1"
shift
key=""

if [[ "$command" == "store" && "${1:-}" == --label=* ]]; then
  shift
fi

if [[ "${1:-}" == "service" && "${2:-}" == "vesper-ai" && "${3:-}" == "provider" ]]; then
  key="default-${4:-}"
elif [[ "${1:-}" == "service" && "${2:-}" == "vesper-ai" && "${3:-}" == "credential" && "${5:-}" == "provider" ]]; then
  key="alias-${4:-}-${6:-}"
else
  exit 2
fi

case "$command" in
  store)
    cat > "$root/$key"
    ;;
  lookup)
    [[ -f "$root/$key" ]]
    cat "$root/$key"
    ;;
  clear)
    rm -f "$root/$key"
    ;;
  *)
    exit 2
    ;;
esac
